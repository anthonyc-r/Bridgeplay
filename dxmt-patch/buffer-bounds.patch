+llvm::Value *
+Converter::EmitGuardedBufferAccess(
+    llvm::Value *Pointer, llvm::Type *ResultType, const std::function<llvm::Value *()> &Emit
+) {
+  if (llvm::cast<llvm::PointerType>(Pointer->getType())->getAddressSpace() == 3)
+    return Emit();
+
+  auto Origin = ir.GetInsertBlock();
+  auto Function = Origin->getParent();
+  auto Access = llvm::BasicBlock::Create(ir.getContext(), "buffer.access", Function);
+  auto Merge = llvm::BasicBlock::Create(ir.getContext(), "buffer.merge", Function);
+  ir.CreateCondBr(ir.CreateIsNotNull(Pointer), Access, Merge);
+  ir.SetInsertPoint(Access);
+  auto Value = Emit();
+  auto AccessEnd = ir.GetInsertBlock();
+  ir.CreateBr(Merge);
+  ir.SetInsertPoint(Merge);
+  if (ResultType->isVoidTy())
+    return nullptr;
+
+  auto Result = ir.CreatePHI(ResultType, 2, "buffer.result");
+  Result->addIncoming(llvm::Constant::getNullValue(ResultType), Origin);
+  Result->addIncoming(Value, AccessEnd);
+  return Result;
+}
